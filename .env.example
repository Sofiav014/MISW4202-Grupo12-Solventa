SECRETO_JWT=compose-development-only-change-me
ALGORITMO_JWT=HS256
URL_DETECTOR=http://detector:8000
URL_IDENTIDAD=http://identity:8000
URL_JOURNEY=http://journey:8000
TIEMPO_ESPERA_DETECTOR_MS=200
TIEMPO_ESPERA_IDENTIDAD_MS=500
TIEMPO_ESPERA_JOURNEY_MS=500
PREFIJO_JOURNEY=/api/journey
# La cabecera X-Escenario-Stub permite que el propio cliente elija el veredicto
# del Detector. Con el Detector real debe quedar apagada: encendida, una corrida
# mediría lo que el generador pidió en vez de lo que el sistema decidió.
PERMITIR_ESCENARIO_STUB=false
GATEWAY_PORT=8080
TTL_SESION_SEGUNDOS=7200
