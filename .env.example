# ── Parámetros del experimento (Fase 0) ──────────────────────────
# Fuente única de verdad. docker-compose los inyecta a cada servicio.
# Cambiar un valor aquí = cambiar la corrida. Nadie edita código Python.

# Adaptador / Circuit Breaker
TIMEOUT_MS=700          # del ASR (fijo, no tocar)
FAIL_MAX=1              # ajustable
RESET_TIMEOUT_S=10      # ajustable
HALF_OPEN_MAX=1         # ajustable

# Caché (Redis)
TTL_S=300              # ajustable

# Registro estructurado por petición (Fase 4)
LOG_DIR=/resultados    # ruta dentro del contenedor, montada en ./resultados
ESCENARIO=A            # A–G; etiqueta con la que se marcan las filas de la corrida
EJECUCION_ID=local     # id de la ejecución; varias por escenario

# Mock del proveedor (estímulo)
MODO=normal            # normal | lento | caido | caida_temporal (también se cambia en caliente vía POST /config)
AUTO_REPARAR_SEGUNDOS=10  # requerido únicamente para caida_temporal
